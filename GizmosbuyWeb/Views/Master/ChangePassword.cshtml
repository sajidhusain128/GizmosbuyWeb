@using System.Globalization
@using Gizmosbuy.Core.Interfaces
@using Gizmosbuy.Core.Models
@model Gizmosbuy.Core.Interfaces.IUserModel
@{
    TempData["Title"] = "Change Password";
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>User Password</h1>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">Change Password</div>
        </div>
        <div class="page-content">
            <div class="page-title">
                <h3></h3>
                <a href="@Url.Action("UsersPassword", "Master")" class="btn btn-primary btn-sm" title="Back to Purchase List"><i class="fas fa-arrow-left"></i> Back to list</a>
            </div>
            <div class="page-body">
                @using (Html.BeginForm("ChangePassword", "Master", FormMethod.Post, new { id = "frmChangePassword" }))
                {
                    @Html.AntiForgeryToken();
                    <input type="hidden" asp-for="UserId" id="hdnUserId" />
                    <input type="hidden" asp-for="Password" id="hdnCurrentPassword" />

                    <div class="form-group">
                        <div class="col-md-12 mb-2">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                </div>
                                <div class="col-auto">
                                    <span id="spnUpdtPwdCommonError" class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 mb-2">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <label for="txtUserName" class="col-form-label">User Name:</label>
                                </div>
                                <div class="col-md-4">
                                    <input type="text" id="txtUserName" class="form-control" asp-for="UserName" placeholder="" autocomplete="off" readonly>
                                </div>
                                <div class="col-auto">
                                    <span class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12 mb-2">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <label for="txtPassword" class="col-form-label">Current Password:</label>
                                </div>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input type="password" id="txtPassword" class="form-control" asp-for="Password" autocomplete="off">
                                        <button type="button" class="form-password-action togglePasswordButton" data-coreui-toggle="password" aria-label="Toggle password visibility" onclick="toggleInputPasswordView(this)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <span class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 mb-2">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <label for="txtNewPassword" class="col-form-label">New Password:</label>
                                </div>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input type="password" id="txtNewPassword" class="form-control" asp-for="NewPassword" autocomplete="off">
                                        <button type="button" class="form-password-action togglePasswordButton" data-coreui-toggle="password" aria-label="Toggle password visibility" onclick="toggleInputPasswordView(this)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <span class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 mb-2">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <label for="txtConfirmPassword" class="col-form-label">Confirm Password:</label>
                                </div>
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input type="password" id="txtConfirmPassword" class="form-control" asp-for="ConfirmPassword" autocomplete="off">
                                        <button type="button" class="form-password-action togglePasswordButton" data-coreui-toggle="password" aria-label="Toggle password visibility" onclick="toggleInputPasswordView(this)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <span class="field-validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12 mb-2">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                </div>
                                <div class="col-md-4">
                                    <button type="button" class="btn btn-custom" id="btnPurchaseUserPassword" title="Update User Password" data-bs-toggle="tooltip"  data-bs-placement="right"><i class="fas fa-save"></i> Update</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/lib/select2/js/select2.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/master.js")" asp-append-version="true"></script>
}