@{
    TempData["Title"] = "Users Password";
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>User Password</h1>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="page-title">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-12 col-12">
                    <div class="row justify-content-end">
                        <button id="btnExportUserPassword" class="btn btn-custom" title="Export To Excel"><i class="fas fa-file-excel"></i> Export</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">User Password List</div>
        </div>
        <div class="page-content p-0">
            <div class="page-body p-0">
                <div class="custom-table table table-bordered table-responsive table-sm m-0 table-striped">
                    <table id="tblUsers" class="">
                        <thead>
                            <tr>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="@Url.Content("~/lib/moment.js/moment.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/master.js")" asp-append-version="true"></script>

    <script type="text/javascript">
        var tableUserPassword = null;
        $(document).ready(function() {

            tableUserPassword = $('#tblUsers').DataTable({
                scrollX: true,
                scrollY: 406,
                scrollCollapse: true,
                fixedColumns: true,
                processing: true,
                serverSide: true,
                pageLength: 10,
                ordering: false,
                "paging": true,
                "ajax": {
                    "url": "/Master/GetUserList",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns": [
                    { "data": null, "title": "#" },
                    { "data": "userName", "title": "UserName" },
                    //{"data": "password","title":"Password"},
                    {
                        "data": "password", "title": "Password", createdCell: function(td, cellData, rowData, row, col) {
                            // Set the data-password attribute
                            $(td).attr('data-password', cellData);

                            // Show masked value instead of raw password
                            $(td).html('<span class="password-span">' + '*'.repeat(cellData.length) + '</span>')
                                .append('<a href="#" class="custom-link-btn ml-2 float-right" onclick="togglePasswordView(this)" data-bs-toggle="tooltip" data-bs-placement="top" title="Show Password"><i class="fas fa-eye fa-md color-info"></i></a>');
                        }
                    },
                    { "data": "userRole", "title": "User Type" },
                    { "data": "locationName", "title": "Location" },
                    {
                        "data": "userId", "title": "Edit", render: function(data, type, row) {
                            if (data === null) return "";

                            return '<a href="/Master/ChangePassword?Id=' + data + '" class="custom-link-btn edit-row mx-2" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit Password"><i class="fas fa-edit fa-lg color-info"></i></a>';
                        }
                    }
                ],
                columnDefs: [
                    { targets: 0, className: 'text-nowrap' },
                    { targets: 1, className: 'text-nowrap' },
                    { targets: 2, className: 'text-nowrap' },
                    { targets: 3, className: 'text-nowrap' },
                    { targets: 4, className: 'text-nowrap' },
                    { targets: 5, className: 'text-nowrap text-center min-width-column' }
                ],
                fixedColumns: {
                    start: 0,           // Unfress frist
                    //end: 1              // freeze the last column
                },
                fnRowCallback: function(nRow, aData, iDisplayIndex) {
                    $("td:first", nRow).html(iDisplayIndex + 1);
                    return nRow;
                },
                deferRender: true,
                initComplete: function() {
                    $('*[title]').tooltip();
                },
                drawCallback: function(settings) {
                    if (settings.aoData.length == 0) {
                        $("#btnExportUserPassword").addClass("disabled");
                    } else {
                        $("#btnExportUserPassword").removeClass("disabled");
                    }
                }
            });

        });
    </script>
}