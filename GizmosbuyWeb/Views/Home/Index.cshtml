@using Gizmosbuy.Core.Constants
@using Gizmosbuy.BAL.Commons;
@{
    string location = Utilities.GetSessionValue(Constant.Location, Context.Request.HttpContext) ?? "";
    TempData["Title"] = "Dashboard (" + location + ")";
    string userRole = Utilities.GetSessionValue(Constant.Role, Context.Request.HttpContext);
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>Dashboard (@location)</h1>
        </div>
    </div>
</div>

<div class="col-md-12">
    <div class="row">

        @if (userRole == "SuperAdmin" || userRole == "Admin")
        {
            var strWidth = (userRole == "SuperAdmin") ? "col-md-12" : "col-md-6";

            <div class="container-block @strWidth col-12">
                <div class="section-block">
                    <div class="page-header">
                        <div class="header-title">Store Return Notifications</div>
                    </div>
                    <div class="page-content p-0">
                        <div class="page-body p-0">
                            <div id="divStoreReturnItemNotification" class="custom-table table table-bordered table-responsive table-sm m-0 table-striped">
                                <table id="tblStoreReturnItemNotification" class="">
                                    <thead>
                                        <tr>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div id="storeReturnNotificationNoDataMessage" class="text-center p-3" style="display:none;">
                                No records available to display
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (userRole == "Admin")
        {

            <div class="container-block col-md-6 col-12">
                <div class="section-block">
                    <div class="page-header">
                        <div class="header-title">Payment Transfer Notifications</div>
                    </div>
                    <div class="page-content p-0">
                        <div class="page-body p-0">
                            <div id="divTransferPaymentNotification" class="custom-table table table-bordered table-responsive table-sm m-0 table-striped table-font-14">
                                <table id="tblTransferPaymentNotification" class="">
                                    <thead>
                                        <tr>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div id="transferPaymentNotificationNoDataMessage" class="text-center p-3" style="display:none;">
                                No records available to display
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@if (userRole == "User")
{
    <div class="container-block">
        <div class="text-center">
            <h1 class="display-4">Welcome to GizmosBuy</h1>
        </div>
    </div>
}

@section Scripts
{
    <script src="@Url.Content("~/lib/moment.js/moment.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/store.js")" asp-append-version="true"></script>

    <script type="text/javascript">

        $(document).ready( function () {
            if("@userRole" == "SuperAdmin" || "@userRole" == "Admin")
            {
                LoadTableStoreReturnItemNotification();
            }
            if("@userRole" == "Admin"){
                LoadTableTransferPaymentNotification();
            }
        });
    </script>
}