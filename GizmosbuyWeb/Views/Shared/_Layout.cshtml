<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@TempData["Title"] - GizmosbuyWeb</title>
    <link rel="stylesheet" href="@Url.Content("~/lib/twitter-bootstrap/css/bootstrap.min.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/custom-css/custom-sidebar.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/lib/font-awesome/css/all.min.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/lib/datatables/css/dataTables.bootstrap5.min.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/lib/datatables/css/fixedColumns.dataTables.min.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/lib/bootstrap-datepicker/css/bootstrap-datepicker3.min.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/custom-css/custom-datepicker.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/custom-css/styles.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/custom-css/custom-loader.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/custom-css/custom-controls.css")" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="toast-container position-fixed top-0 end-0 p-2">
        <div id="toastSuccess" class="toast text-bg-success" role="alert" data-bs-delay="3000" data-bs-autohide="true" aria-live="assertive" aria-atomic="true">
            <div class="toast-body">
                <div class="d-flex gap-3">
                    <span class="align-self-center"><i class="fa-solid fa-circle-check fa-xl"></i></span>
                    <div class="d-flex flex-column lh-base">
                        <strong>Success!</strong>
                        <span class="body-text">Successful!</span>
                    </div>
                    <button type="button"
                            class="btn-close btn-close-sm ms-auto"
                            data-bs-dismiss="toast"
                            aria-label="Close"></button>
                </div>
            </div>
        </div>
        <div id="toastWarning" class="toast text-bg-warning" role="alert" data-bs-delay="3000" data-bs-autohide="true" aria-live="assertive" aria-atomic="true">
            <div class="toast-body">
                <div class="d-flex gap-3">
                    <span class="align-self-center"><i class="fa-solid fa-circle-exclamation fa-xl"></i></span>
                    <div class="d-flex flex-column lh-base">
                        <strong>Warning!</strong>
                        <span class="body-text">Trying again...</span>
                    </div>
                    <button type="button"
                            class="btn-close btn-close-sm ms-auto"
                            data-bs-dismiss="toast"
                            aria-label="Close"></button>
                </div>
            </div>
        </div>
        <div id="toastError" class="toast fade text-bg-danger" role="alert">
            <div class="toast-body">
                <div class="d-flex gap-3">
                    <span class="align-self-center"><i class="fa-solid fa-triangle-exclamation fa-xl"></i></span>
                    <div class="d-flex flex-column lh-base">
                        <strong>Error!</strong>
                        <span class="body-text">We are having issues</span>
                    </div>
                    <button type="button"
                            class="btn-close btn-close-sm ms-auto"
                            data-bs-dismiss="toast"
                            aria-label="Close"></button>
                </div>
            </div>
        </div>
    </div>

    <div class="wrapper d-flex align-items-stretch">
        @await Html.PartialAsync("_Sidebar.cshtml")
        <section id="content">
            @await Html.PartialAsync("_Navbar.cshtml")
            <main role="main" class="main-section mb-3">
                <div class="container-fluid" style="padding:0px">
                    @RenderBody()
                </div>
            </main>
            <footer class="border-top site-footer text-muted">
                <div class="container-fluid">
                    Copyright ©<script>document.write(new Date().getFullYear());</script> All rights reserved - GizmosbuyWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
            </footer>
        </section>
    </div>

    @await Html.PartialAsync("_Loader")

    <script src="@Url.Content("~/lib/jquery/dist/jquery.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/lib/twitter-bootstrap/js/bootstrap.bundle.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/lib/datatables/js/dataTables.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/lib/datatables/js/dataTables.bootstrap5.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/lib/datatables/js/dataTables.fixedColumns.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/lib/bootstrap-datepicker/js/bootstrap-datepicker.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/shared.js")" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script type="text/javascript">
            $(document).ready(function() {

                $('#sidebarCollapse').on('click', function() {
                    $('#sidebar').toggleClass('active');
                });

                $(window).on('resize', function() {
                    var win = $(this); //this = window

                    if (win.width() <= 992) {
                        $('#sidebar').removeClass("active");
                    }
                    else {
                        if (!$('#sidebar').hasClass("active")) {
                            $('#sidebar').addClass("active");
                        }
                    }
                });

            });
    </script>
</body>
</html>
