@using Gizmosbuy.Core.Constants
@using Microsoft.AspNetCore.Http;
@using Gizmosbuy.BAL.Commons;

@{
    var userName = Utilities.GetSessionValue(Constant.UserName, Context.Request.HttpContext);
}
<nav class="navbar navbar-expand navbar-toggleable fixed-top ">
    @* <i class="fas fa-chevron-left" id="sidebarCollapse"></i> *@
    <i class="fas fa-bars" id="sidebarCollapse"></i>
    @* <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">GizmosbuyWeb</a> *@
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
            aria-expanded="false" aria-label="Toggle navigation">
        <i class="fa-solid fa-ellipsis-vertical"></i>
    </button>

    <div class="navbar-collapse collapse">
        <ul class="navbar-nav flex-grow-1">
            @* <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Auth" asp-action="Logout">Logout</a>
                                </li> *@
        </ul>
        <ul class="nav col-12 col-lg-auto justify-content-center my-md-0 text-small">
            <li class="nav-item dropdown">
                <a aria-current="page" href="/dashboard#" class="active-link exact-active-link nav-link dropdown-toggle show" role="button" data-bs-toggle="dropdown" aria-expanded="true"> Hi, @userName</a>
                <ul class="dropdown-menu" style="left: initial; right: 0px;" data-bs-popper="static">
                    <li>
                        @using (Html.BeginForm("Logout", "Auth", HttpMethods.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button aria-current="page" type="submit" class="active-link exact-active-link dropdown-item">Logout</button>
                        }
                    </li>
                </ul>
            </li>
        </ul>
    </div>
</nav>

<div class="dropdown-menu notification-ui_dd " aria-labelledby="navbarDropdown">
    <div class="notification-ui_dd-header">
        <h3 class="text-center">Notification</h3>
    </div>
    <div class="notification-ui_dd-content">
        <div class="notification-list notification-list--unread">
            <div class="notification-list_img">
                <i class="fa-solid fa-store"></i>
            </div>
            <div class="notification-list_detail">
                <p><b>John Doe</b> reacted to your post</p>
                @* <p><small>10 mins ago</small></p> *@
            </div>
            <div class="notification-list_feature-img">
                <i class="fa-solid fa-xmark"></i>
            </div>
        </div>
        <div class="notification-list notification-list--unread">
            <div class="notification-list_img">
                <img src="https://i.imgur.com/w4Mp4ny.jpg" alt="user">
            </div>
            <div class="notification-list_detail">
                <p><b>Richard Miles</b> reacted to your post</p>
                @* <p><small>1 day ago</small></p> *@
            </div>
            <div class="notification-list_feature-img">
                <img src="https://i.imgur.com/AbZqFnR.jpg" alt="Feature image">
            </div>
        </div>
        <div class="notification-list">
            <div class="notification-list_img">
                <img src="https://i.imgur.com/ltXdE4K.jpg" alt="user">
            </div>
            <div class="notification-list_detail">
                <p><b>Brian Cumin</b> reacted to your post</p>
                @* <p><small>1 day ago</small></p> *@
            </div>
            <div class="notification-list_feature-img">
                <img src="https://i.imgur.com/bpBpAlH.jpg" alt="Feature image">
            </div>
        </div>
        <div class="notification-list">
            <div class="notification-list_img">
                <img src="https://i.imgur.com/CtAQDCP.jpg" alt="user">
            </div>
            <div class="notification-list_detail">
                <p><b>Lance Bogrol</b> reacted to your post</p>
                @* <p><small>1 day ago</small></p> *@
            </div>
            <div class="notification-list_feature-img">
                <img src="https://i.imgur.com/iIhftMJ.jpg" alt="Feature image">
            </div>
        </div>
    </div>
    <div class="notification-ui_dd-footer">
        <a href="#!" class="btn btn-success btn-block">View All</a>
    </div>
</div>