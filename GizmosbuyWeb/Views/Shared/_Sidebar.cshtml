@using Gizmosbuy.Core.Constants
@using Gizmosbuy.BAL.Commons;

@{
    string userRole = Utilities.GetSessionValue(Constant.Role, Context.Request.HttpContext);
}

<nav id="sidebar" class="active">
    <a href="@Url.Action("Index", "Home")" class="image-box">
        <div class="img logo" style="background-image: url(@Url.Content("~/images/gizmosbuy-logo-square.jpg"));">
            @* <img src="~/images/gizmosbuy-logo-square.jpg" /> *@

        </div>
    </a>
    <div class="p-3">
        <ul class="list-unstyled components mb-5">
            <li>
                <a href="@Url.Action("Index", "Home")">
                    <div>
                        <i class="fas fa-dashboard"></i>
                        <span>Dashboard</span>
                    </div>
                </a>
            </li>
            <li class="has-sub-list">
                <a href="javascript:void(0)">
                    <div>
                        <i class="fa-regular fa-rectangle-list"></i>
                        <span>Entry</span>
                    </div>
                    <i class="expander fa-solid fa-square-plus"></i>
                </a>
                <ul class="sub-list">
                    @if (userRole == "SuperAdmin" || userRole == "Admin")
                    {
                        <li>
                            <a href="@Url.Action("Index", "Purchase")">
                                <div>
                                    <i class="fa-solid fa-cart-shopping"></i>
                                    <span>Purchase</span>
                                </div>
                            </a>
                        </li>
                    }
                    @if (userRole == "SuperAdmin" || userRole == "Admin" || userRole == "User")
                    {
                        <li>
                            <a href="@Url.Action("Index", "Sales")">
                                <div>
                                    <i class="fa-solid fa-people-arrows"></i>
                                    <span>Sales</span>
                                </div>
                            </a>
                        </li>
                    }
                    @if (userRole == "SuperAdmin" || userRole == "Admin")
                    {
                        <li>
                            <a href="@Url.Action("Index", "Store")">
                                <div>
                                    <i class="fa-solid fa-cart-flatbed"></i>
                                    <span>Store Transfer</span>
                                </div>
                            </a>
                        </li>
                    }
                    @if (userRole == "Admin")
                    {
                        <li>
                            <a href="@Url.Action("TransferPayment", "Store")">
                                <div>
                                    <i class="fa-solid fa-money-bill-transfer"></i>
                                    <span>Transfer Payment</span>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            </li>
            @if (userRole == "SuperAdmin" || userRole == "Admin")
            {
                <li class="has-sub-list">
                    <a href="javascript:void(0)">
                        <div>
                            <i class="fa-solid fa-receipt"></i>
                            <span>Report</span>
                        </div>
                        <i class="expander fa-solid fa-square-plus"></i>
                    </a>
                    <ul class="sub-list">
                        @if (userRole == "SuperAdmin" || userRole == "Admin")
                        {
                            <li>
                                <a href="@Url.Action("RawData", "Inventory")">
                                    <div>
                                        <i class="fas fa-table"></i>
                                        <span>Raw Data</span>
                                    </div>
                                </a>
                            </li>
                        }
                        @if (userRole == "SuperAdmin" || userRole == "Admin")
                        {
                            <li>
                                <a href="@Url.Action("Summary", "Inventory")">
                                    <div>
                                        <i class="fas fa-hourglass-half"></i>
                                        <span>Summary</span>
                                    </div>
                                </a>
                            </li>
                        }
                        @if (userRole == "SuperAdmin")
                        {
                            <li>
                                <a href="@Url.Action("PaymentSummary", "Inventory")">
                                    <div>
                                        <i class="fas fa-money-check-dollar"></i>
                                        <span>Payment Summary</span>
                                    </div>
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
            @if (userRole == "SuperAdmin")
            {
                <li class="has-sub-list">
                    <a href="javascript:void(0)">
                        <div>
                            <i class="fas fa-list"></i>
                            <span>Masters</span>
                        </div>
                        <i class="expander fa-solid fa-square-plus"></i>
                    </a>
                    <ul class="sub-list">
                        <li>
                            <a href="@Url.Action("UsersPassword", "Master")">
                                <div>
                                    <i class="fas fa-user"></i>
                                    <span>Users Password</span>
                                </div>
                            </a>
                        </li>
                    </ul>
                </li>
            }
            @* <li>
                            <a href="#pageSubmenu" data-toggle="collapse" aria-expanded="false" class="dropdown-toggle">Sales</a>
                            <ul class="collapse list-unstyled" id="pageSubmenu">
                                <li>
                                    <a href="#">Page 1</a>
                                </li>
                                <li>
                                    <a href="#">Page 2</a>
                                </li>
                                <li>
                                    <a href="#">Page 3</a>
                                </li>
                            </ul> 
                        </li> *@


        </ul>
        <div class="footer">
            @* <p>
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                        Copyright ©<script>document.write(new Date().getFullYear());</script> All rights reserved
                        This template is made with <i class="icon-heart" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib.com</a>
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                    </p> *@
        </div>
    </div>
</nav>