@{
    TempData["Title"] = "Transfer Payment";
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>Transfer Payment</h1>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="page-title">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-12 col-12">
                    <div class="row">
                        <div class="col-md-6 col-6">
                            <div class="row">
                                <a href="@Url.Action("CreateTransferPayment", "Store")" class="btn btn-custom" title="Create Store Transfer Payment Entry"><i class="fas fa-save"></i> Create Entry</a>
                            </div>
                        </div>
                        <div class="col-md-6 col-6">
                            <div class="row justify-content-end">
                                <button id="btnExportTransferPayment" class="btn btn-custom" title="Export To Excel"><i class="fas fa-file-excel"></i> Export</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">Store Transfer Payment</div>
        </div>
        <div class="page-content p-0">
            <div class="page-body p-0">
                <div class="custom-table table table-bordered table-responsive table-sm m-0 table-striped">
                    <table id="tblTransferPayment" class="">
                        <thead>
                            <tr>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PartialTransferPaymentDeletePopup.cshtml")

@section Scripts
{
    <script src="@Url.Content("~/lib/moment.js/moment.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/store.js")" asp-append-version="true"></script>

    <script type="text/javascript">
        var tableTransferPayment = null;

        $(document).ready( function () {

            tableTransferPayment = $('#tblTransferPayment').DataTable({
                scrollX: true,
                scrollY: 406,
                scrollCollapse: true,
                //fixedColumns: true,
                processing: true,
                serverSide:true,
                pageLength:10,
                order: [], // disables initial sort
                "paging":true,
                "ajax":{
                    "url": "/Store/GetTransferPaymentList",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns":[
                    {"title":"Sr No.",render:function (data, type, row){
                        return "";
                    }},
                    {"data": "paymentDate","title":"Payment Date",render:function (data, type, row){
                        if(data === null) return "";

                        return moment(data).format('DD/MM/YYYY');
                    }},
                    {"data": "amount","title":"Transfer Amount",render:function (data, type, row){
                        if(data === null) return "";

                        return "&#8377; "+ data;
                    }},
                    {"data": "transferMode","title":"Payment Mode"},
                    {"data": "remark","title":"Remark"},
                    {"data": "toLocation","title":"To Location"},
                    {"data": "approvedStatus","title":"Approved Status"},
                    {"data": "transferPaymentID","title":"Action",render:function (data, type, row){
                        if(data === null) return "";

                        return `<a href=${row.isApproved == null ?  "/Store/EditTransferPayment?Id=" + data : "javascript:void(0)"} class="custom-link-btn mr-3 ${row.isApproved == null ? "" : "disabled"}" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit Transfer Payment Entry"><i class="fas fa-edit fa-lg color-info"></i></a>`+
                        `<a href="javascript:void(0)" ${row.isApproved == null ? 'onclick="showDeleteTransferPaymentModel(' + data + ')"' : ''} class="custom-link-btn ${row.isApproved != null ? 'disabled': ''}" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete Transfer Payment Entry"><i class="fas fa-trash fa-lg color-danger"></i></a>`;
                    }}
                ],
                "fnRowCallback" : function(nRow, aData, iDisplayIndex){
                           $("td:first", nRow).html(iDisplayIndex +1);
                           return nRow;
                },
                columnDefs: [
                    { targets: 0,className: 'text-nowrap text-center'},
                    { targets: 1,className: 'text-nowrap'},
                    { targets: 2,className: 'text-nowrap'},
                    { targets: 3,className: 'text-nowrap'},
                    { targets: 4,className: 'text-nowrap'},
                    { targets: 5,className: 'text-nowrap'},
                    { targets: 6,className: 'text-nowrap'},
                    { targets: 7,className: 'text-nowrap text-center min-width-column',"orderable": false}
                ],
                fixedColumns: {
                    start: 0,           // Unfress frist
                    end: 1              // freeze the last column
                },
                initComplete: function () {
                    $('*[title]').tooltip();
                }
            });
        });
    </script>
}