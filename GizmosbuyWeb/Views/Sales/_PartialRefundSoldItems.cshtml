<div class="modal fade" id="tempRefundSoldItemsModel" tabindex="-1" aria-labelledby="tempRefundSoldItemsModelLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tempRefundSoldItemsModelLabel">Refund Sold Items</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close Modal">
                    <i class="fa fa-solid fa-lg fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div>
                    @using (Html.BeginForm("", "", FormMethod.Post, new { id = "frmSalesRefund" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-0">
                            <div class="col-md-12 mb-2">
                                <div class="row align-items-center">
                                    <h6 style="font-weight: 600;" class="p-0">Please enter below detail for refund sold items.</h6>
                                </div>
                            </div>
                            <div class="col-md-12 col-12 mb-2">
                                <div class="row">
                                    <span id="spnInvoiceNoError" class="field-validation-error p-0"></span>
                                </div>
                            </div>
                            <div class="col-md-12 col-12">
                                <div class="row align-items-center">
                                    <div class="col-md-6 col-12 my-2">
                                        <div class="row">
                                            <input type="text" id="txtInvoiceNo" class="form-control" placeholder="Invoice No." autocomplete="off">
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-12">
                                        <div class="row justify-content-end">
                                            <div class="col-md-6 my-2">
                                                <div class="">
                                                    <button type="button" class="btn btn-custom" id="btnFetchInvoiceDetails" title="Click here to fetch invoice details"><i class="fa-solid fa-circle-arrow-down"></i> Fetch</button>
                                                </div>
                                            </div>
                                            <div class="col-md-6 my-2">
                                                <div class="row justify-content-end">
                                                    <button type="button" class="btn btn-info" id="btnClearInvoiceDetails" title="Clear invoice details"><i class="fa-solid fa-eraser"></i> Clear</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @* <div class="col-auto">
                                        <span class="field-validation-error"></span>
                                    </div> *@
                                </div>
                            </div>

                            <div id="divInvoiceDetails">
                            </div>
                        </div>

                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnRefundSalesItemsClose" data-bs-dismiss="modal" title="Close Modal"><i class="fas fa-xmark"></i> Close</button>
                <button type="button" class="btn btn-custom" id="btnRefundSalesItemsSave" title="Submit to Refund Sales Entry"><i class="fas fa-save"></i> Submit</button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PartialDeleteSalesConfirmModal.cshtml")