@using Microsoft.AspNetCore.Http;
@{
    ViewBag.Title = "Index";
    string userRole = Context.Session.GetString("Role");
}

<div class="page-header">
    <div class="header-title">Sales List</div>
</div>
<div class="page-content">
    <div class="page-title">
        <h3></h3>
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6 col-sm-12">
                    <div class="row">
                        <a href="@Url.Action("Create","Sales")" class="btn btn-custom" title="Create Sales Entry"><i class="fas fa-save"></i> Create Entry</a>
                    </div>

                </div>
                @if (userRole == "SuperAdmin" || userRole == "Admin")
                {
                    <div class="col-md-6 col-sm-12">
                        <div class="row float-end">
                            <button id="btnRefundSalesModal" class="btn btn-custom" title="Refund Sold Items"><i class="fa-solid fa-money-bill"></i> Refund</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="page-body">
        <div class="custom-table table table-bordered table-responsive table-sm mt-2 table-striped">
            <table id="tblSales" class="">
                <thead>
                    <tr>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_PartialRefundSoldItems.cshtml")

@section Scripts
{
    <script src="@Url.Content("~/lib/moment.js/moment.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/scripts.js")" asp-append-version="true"></script>

    <script type="text/javascript">

        $(document).ready( function () {

            var form = $("#frmSales");
            var token = $('input[name="__RequestVerificationToken"]', form).val();

            $('#tblSales').DataTable({
                scrollX: true,
                scrollY: 406,
                scrollCollapse: true,
                fixedColumns: true,
                processing: true,
                serverSide:true,
                pageLength:10,
                "paging":true,
                "ajax":{
                    "url": "/Sales/GetSalesList",
                    "type": "POST",
                    "datatype": "json",
                    "data": { __RequestVerificationToken: token },
                },
                "columns":[
                    {"data": "salesID","title":"Sr.No."},
                    {"data": "serialNo","title":"Serial No"},
                    {"data": "categoryName","title":"Category"},
                    {"data": "brandName","title":"Brand"},
                    {"data": "model","title":"Model"},
                    {"data": "specifications","title":"Specifications"},
                    {"data": "sellingQuantity","title":"Selling Quantity"},
                    {"data": "sellingDate","title":"Selling Date",render:function (data, type, row){
                        if(data === null) return "";

                        return moment(data).format('DD/MM/YYYY');
                    }},
                    {"data": "sellingPrice","title":"Selling Price",render:function (data, type, row){
                        if(data === null) return "";

                        return "&#8377;"+ data;
                    }},
                    {"data": "paymentMode","title":"Payment Mode"},
                    {"data": "customerName","title":"Customer Name"},
                    {"data": "contactNo","title":"Contact No"},

                    {"data": "location","title":"Location"},
                    {"data": "billNo","title":"Bill No"},
                    {"data": "sellingLead","title":"Selling Lead"},
                    {"data": "salesID","title":"Edit",render:function (data, type, row){
                        if(data === null) return "";

                        return '<a href="/Sales/Edit?Id=' + data + '" class="custom-link-btn" title="Edit Sales Entry"><i class="fas fa-edit fa-lg color-info"></i></a>';
                    }},
                    {"data": "billNo","title":"Download",render:function (data, type, row){
                        if(data === null) return "";

                        return '<a href="/Sales/DownloadSalesReport?invoiceNo=' + data + '" class="custom-link-btn" title="Download Report"><i class="fas fa-download fa-lg color-info"></i></a>';
                    }}
                ],
                columnDefs: [
                    { targets: 0,className: 'text-nowrap'},
                    { targets: 1,className: 'text-nowrap'},
                    { targets: 2,className: 'text-nowrap'},
                    { targets: 3,className: 'text-nowrap'},
                    { targets: 4,className: 'text-nowrap'},
                    { targets: 5,className: 'text-nowrap'},
                    { targets: 6,className: 'text-nowrap text-right'},
                    { targets: 7,className: 'text-nowrap'},
                    { targets: 8,className: 'text-nowrap text-right'},
                    { targets: 9,className: 'text-nowrap'},
                    { targets: 10,className: 'text-nowrap'},
                    { targets: 11,className: 'text-nowrap'},
                    { targets: 12,className: 'text-nowrap'},
                    { targets: 13,className: 'text-nowrap'},
                    { targets: 14,className: 'text-nowrap'},
                    { targets: 15,className: 'text-nowrap text-center'},
                    { targets: 16,className: 'text-nowrap text-center'}
                ],
                initComplete: function () {
                    $('*[title]').tooltip();
                }
            });
        });
    </script>
}