@model List<Gizmosbuy.Core.Interfaces.ISalesModel>

@if (Model != null && Model.Count > 0)
{
    <input type="hidden" id="hdnIvoiceNo" value="@Model.FirstOrDefault().BillNo" />
    <div class="custom-table table table-bordered table-responsive table-sm mt-2 table-striped">
        <table id="tblInvoiceDetails" class="">
            <thead>
                <tr>
                    <th>Bill No.</th>
                    <th>Serial No.</th>
                    <th>Model</th>
                    <th>Selling Price</th>
                    <th>Customer Name</th>
                    <th>Contact No.</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BillNo</td>
                            <td>@item.SerialNo</td>
                            <td>@item.Model</td>
                            <td align="right">@Math.Round(item.SellingPrice.GetValueOrDefault(), 2)</td>
                            <td>@item.CustomerName</td>
                            <td>@item.ContactNo</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" align="center"> Record not found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}