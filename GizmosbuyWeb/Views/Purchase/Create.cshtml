@using Gizmosbuy.Core.Interfaces
@using Gizmosbuy.Core.Models
@model Gizmosbuy.Core.Models.PurchaseModel
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="page-header">
    <div class="header-title">Purchase Entry</div>
</div>
<div class="page-content">
    <div class="page-title">
        <h3></h3>
        <a href="@Url.Action("Index","Purchase")" class="btn btn-primary btn-sm" title="Back to Purchase List"><i class="fas fa-arrow-left"></i> Back to list</a>
    </div>
    <div class="page-body">
        @using (Html.BeginForm("Create", "Purchase", FormMethod.Post, new { id = "frmPurchase" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtSrNo" class="col-form-label">Serial No:</label>
                        </div>
                        <div class="col-md-4">
                            <input type="text" id="txtSrNo" class="form-control" asp-for="SerialNo" placeholder="" autocomplete="off">
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtPurchaseDate" class="col-form-label">Purchase Date:</label>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <input type="text" id="txtPurchaseDate" class="form-control" asp-for="PurchaseDate" placeholder="DD/MM/YYYY" maxlength="10" pattern="[0-9/]*" onkeyup="dateAutoFormatter(event)" autocomplete="off">
                                <span class="input-group-text" id="basic-addon1">
                                    <i class="fas fa-calendar-alt"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="ddlCategory" class="col-form-label">Category:</label>
                        </div>
                        <div class="col-md-4">
                            @Html.DropDownListFor(Model => Model.CategoryId, new SelectList(((List<ICategoryModel>)ViewBag.Categories).Select(x => new { Value = x.CategoryId, Text = x.CategoryName }), "Value", "Text"), null, new { id = "ddlCategory", @class = "form-select" })
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="ddlBrand" class="col-form-label">Brand:</label>
                        </div>
                        <div class="col-md-4">
                            @Html.DropDownListFor(Model => Model.BrandId, new SelectList(((List<IBrandModel>)ViewBag.Brands).Select(x => new { Value = x.BrandId, Text = x.BrandName }), "Value", "Text"), null, new { id = "ddlBrand", @class = "form-select" })
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtModel" class="col-form-label">Model:</label>
                        </div>
                        <div class="col-md-4">
                            <input type="text" id="txtModel" class="form-control" asp-for="Model" autocomplete="off">
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtSpecs" class="col-form-label">Specifications:</label>
                        </div>
                        <div class="col-md-4">
                            <input type="text" id="txtSpecs" class="form-control" asp-for="Specifications" autocomplete="off">
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtPurchasePrice" class="col-form-label">Purchase Price:</label>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <input type="text" id="txtPurchasePrice" class="form-control text-right" asp-for="PurchasePrice" onkeypress="isNumberDecimal(this, event);" autocomplete="off">
                                <span class="input-group-text" id="txtPurchasePrice-addon1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-rupee" viewBox="0 0 16 16">
                                        <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4z" />
                                    </svg>
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="Quantity" class="col-form-label">Quantity:</label>
                        </div>
                        <div class="col-md-4">
                            <input type="text" id="txtQuantity" class="form-control" asp-for="Quantity" onkeypress="numberOnly(event)" autocomplete="off">
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtUpgrade" class="col-form-label">Repair/Upgrade:</label>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <input type="text" id="txtUpgrade" class="form-control text-right" asp-for="UpgradePrice" onkeypress="isNumberDecimal(this, event);" autocomplete="off">
                                <span class="input-group-text" id="txtPurchasePrice-addon1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-rupee" viewBox="0 0 16 16">
                                        <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4z"></path>
                                    </svg>
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtPurcRepair" class="col-form-label">Purhase & Repair:</label>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <input type="text" id="txtPurcRepair" class="form-control text-right" readonly asp-for="TotalPrice" onkeypress="isNumberDecimal(this, event);" autocomplete="off">
                                <span class="input-group-text" id="txtPurchasePrice-addon1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-rupee" viewBox="0 0 16 16">
                                        <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4z"></path>
                                    </svg>
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="ddlPayMode" class="col-form-label">Payment Mode:</label>
                        </div>
                        <div class="col-md-4">
                            @Html.DropDownListFor(Model => Model.PaymentModeId, new SelectList(((List<IPaymentModeModel>)ViewBag.PaymentModes).Select(x => new { Value = x.PaymentModeId, Text = x.PaymentModeName }), "Value", "Text"), null, new { id = "ddlPayMode", @class = "form-select" })
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <label for="txtBuyLead" class="col-form-label">Buying Lead:</label>
                        </div>
                        <div class="col-md-4">
                            <input type="text" id="txtBuyLead" class="form-control" asp-for="BuyingLead" autocomplete="off">
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 mb-2">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-custom" id="btnPurchaseSave" title="Save Purchase Entry"><i class="fas fa-save"></i> Save</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Styles{
@* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css"> *@
<link href="@Url.Content("~/lib/select2/css/select2.min.css")" rel="stylesheet" />
<link href="@Url.Content("~/css/custom-css/custom-select2.css")" rel="stylesheet" />
}

@section Scripts {
    <script src="@Url.Content("~/lib/select2/js/select2.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/scripts.js")" asp-append-version="true"></script>

    <script>
        $(document).ready( function () {

            $('#txtUpgrade').blur(function(){
                if($(this).val() == ""){
                    $(this).val("0");
                }
            });

            $('#txtPurchaseDate').datepicker({
                format: 'dd/mm/yyyy',
                endDate: '+1d',
                maxDate: 'today',
                autoclose: true,
                todayHighlight: true,
                todayBtn: true,
                clearBtn: true
            });

            $('#ddlCategory,#ddlBrand,#ddlPayMode').select2();
        });
    </script>
}