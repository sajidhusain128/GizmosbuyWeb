@{
    TempData["Title"] = "Purchase";
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>Purchase</h1>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">Purchase List</div>
        </div>
        <div class="page-content">
            <div class="page-title">
                <h3></h3>
                <a href="@Url.Action("Create", "Purchase")" class="btn btn-custom" title="Create Purchase Entry"><i class="fas fa-save"></i> Create Entry</a>
            </div>
            <div class="page-body">
                <div class="custom-table table table-bordered table-responsive table-sm mt-2 table-striped">
                    <table id="tblPurchase" class="">
                        <thead>
                            <tr>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_PartialPurchaseDeletePopup.cshtml")

@section Scripts
{
    <script src="@Url.Content("~/lib/moment.js/moment.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/scripts.js")" asp-append-version="true"></script>

    <script type="text/javascript">

        $(document).ready( function () {

            $('#tblPurchase').DataTable({
                scrollX: true,
                scrollY: 406,
                scrollCollapse: true,
                fixedColumns: true,
                processing: true,
                serverSide:true,
                pageLength:10,
                order: [], // 👈 disables initial sort
                "paging":true,
                "ajax":{
                    "url": "/Purchase/GetPurchaseList",
                    "type": "POST",
                    "datatype": "json"
                },
                "columns":[
                    {"data": "serialNo","title":"Serial No"},
                    {"data": "purchaseDate","title":"Purchase Date",render:function (data, type, row){
                        if(data === null) return "";

                        return moment(data).format('DD/MM/YYYY');
                    }},
                    {"data": "categoryName","title":"Category"},
                    {"data": "brandName","title":"Brand"},
                    {"data": "model","title":"Model"},
                    {"data": "specifications","title":"Specifications"},
                    {"data": "purchasePrice","title":"Purchase Price",render:function (data, type, row){
                        if(data === null) return "";

                        return "&#8377; "+ data;
                    }},
                    {"data": "quantity","title":"Quantity"},
                    {"data": "upgradePrice","title":"Upgrade Price",render:function (data, type, row){
                        if(data === null) return "";

                        return "&#8377; "+ data;
                    }},
                    {"data": "totalPrice","title":"Total Price",render:function (data, type, row){
                        if(data === null) return "";

                        return "&#8377; "+ data;
                    }},
                    {"data": "paymentMode","title":"Payment Mode"},
                    {"data": "buyingLead","title":"BuyingLead"},
                    {"data": "purchaseID","title":"Edit",render:function (data, type, row){
                        if(data === null) return "";

                        return '<a href="'+(row.canDelete == 0 ? "javascript:void(0)" : "/Purchase/Edit?Id=" + data)+'" class="custom-link-btn '+ (row.canDelete == 0 ? "disabled" : "") +'" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit Purchase Entry"><i class="fas fa-edit fa-lg color-info"></i></a>';
                    }},
                    {"data": "purchaseID","title":"Delete",render:function (data, type, row){
                        if(data === null) return "";

                        return '<a href="javascript:void(0)" ' + (row.canDelete == 0 ? "" : "onclick='showDeletePurchaseModel(" + data + ")'") + ' class="custom-link-btn '+ (row.canDelete == 0 ? "disabled" : "") +'" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete Purchase Entry"><i class="fas fa-trash fa-lg color-danger"></i></a>';
                    }}
                ],
                columnDefs: [
                    { targets: 0,className: 'text-nowrap'},
                    { targets: 1,className: 'text-nowrap'},
                    { targets: 2,className: 'text-nowrap'},
                    { targets: 3,className: 'text-nowrap'},
                    { targets: 4,className: 'text-nowrap'},
                    { targets: 5,className: 'text-nowrap'},
                    { targets: 6,className: 'text-nowrap text-right'},
                    { targets: 7,className: 'text-nowrap'},
                    { targets: 8,className: 'text-nowrap text-right'},
                    { targets: 9,className: 'text-nowrap text-right'},
                    { targets: 10,className: 'text-nowrap'},
                    { targets: 11,className: 'text-nowrap'},
                    { targets: 12,className: 'text-nowrap text-center min-width-column',"orderable": false},
                    { targets: 13,className: 'text-nowrap text-center min-width-column',"orderable": false}
                ],
                initComplete: function () {
                    $('*[title]').tooltip();
                }
            });
        });
    </script>
}