@using System.Globalization
@using Gizmosbuy.Core.Interfaces
@model Gizmosbuy.Core.Interfaces.IPurchaseModel
@{
    TempData["Title"] = "Edit Purchase";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var transferPurchaseID = ViewBag.TransferPurchaseID;
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>Purchase</h1>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="page-title">
        <a href="@Url.Action("Index", "Purchase")" class="btn btn-primary btn-sm" title="Back to Purchase List"><i class="fas fa-arrow-left"></i> Back to list</a>
    </div>
</div>
<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">Purchase Edit</div>
        </div>
        <div class="page-content">
            <div class="page-body p-0">
                @using (Html.BeginForm("Create", "Purchase", FormMethod.Post, new { id = "frmPurchase" }))
                {
                    @Html.AntiForgeryToken()
                    ;
                    <input type="hidden" asp-for="PurchaseId" id="hdnPurchaseId" />

                    <div class="col-md-12 col-12">
                        <div class="row">
                            <div class="col-md-6 col-12">
                                <div class="">
                                    <label for="txtSrNo" class="col-form-label">Serial No:</label>
                                    <input type="text" id="txtSrNo" class="form-control" asp-for="SerialNo" placeholder="" autocomplete="off" readonly="@(transferPurchaseID > 0)">
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="txtPurchaseDate" class="col-form-label">Purchase Date:</label>
                                    <div class="input-group ">
                                        @{
                                            var pDate = Model.PurchaseDate.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
                                        }

                                        <input type="text" id="txtPurchaseDate" class="form-control" asp-for='@pDate' placeholder="DD/MM/YYYY" pattern="\d{1,2}/\d{1,2}/\d{4}" maxlength="10" pattern="[0-9/]*" onkeypress="return false;" onKeyDown="preventBackspace();" onpaste="return false;" autocomplete="off" readonly="@(transferPurchaseID > 0)">
                                        <span class="input-group-text" id="basic-addon1">
                                            <i class="fas fa-calendar-alt"></i>
                                        </span>
                                    </div>
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="ddlCategory" class="col-form-label">Category:</label>
                                    @Html.DropDownListFor(Model => Model.CategoryId, new SelectList(((List<ICategoryModel>)ViewBag.Categories).Select(x => new { Value = x.CategoryId, Text = x.CategoryName }), "Value", "Text"), null, new { id = "ddlCategory", @class = "form-select select2-dropdown" + (transferPurchaseID > 0 ? "select2-readonly " : ""), @style = "width:100% !important" })
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="ddlBrand" class="col-form-label">Brand:</label>
                                    @Html.DropDownListFor(Model => Model.BrandId, new SelectList(((List<IBrandModel>)ViewBag.Brands).Select(x => new { Value = x.BrandId, Text = x.BrandName }), "Value", "Text"), null, new { id = "ddlBrand", @class = "form-select select2-dropdown" + (transferPurchaseID > 0 ? "select2-readonly " : ""), @style = "width:100% !important", @readonly = (transferPurchaseID > 0) })
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="txtModel" class="col-form-label">Model:</label>
                                    <input type="text" id="txtModel" class="form-control" asp-for="Model" autocomplete="off" readonly="@(transferPurchaseID > 0)">
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="txtSpecs" class="col-form-label">Specifications:</label>
                                    <input type="text" id="txtSpecs" class="form-control" asp-for="Specifications" autocomplete="off" readonly="@(transferPurchaseID > 0)">
                                    <span class="field-validation-error"></span>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="">
                                    <label for="txtPurchasePrice" class="col-form-label">Purchase Price:</label>
                                    <div class="input-group">
                                        @{
                                            var pPrice = String.Format("{0:0.00}", Model.PurchasePrice);
                                        }
                                        <input type="text" id="txtPurchasePrice" class="form-control text-right" asp-for="@pPrice" onkeypress="isNumberDecimal(this, event);" autocomplete="off" readonly="@(transferPurchaseID > 0)">
                                        <span class="input-group-text" id="txtPurchasePrice-addon1">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-rupee" viewBox="0 0 16 16">
                                                <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4z" />
                                            </svg>
                                        </span>
                                    </div>
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="Quantity" class="col-form-label">Quantity:</label>
                                    <input type="text" id="txtQuantity" class="form-control" asp-for="Quantity" onkeypress="numberOnly(event)" autocomplete="off" tabindex="-1" readonly>
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="txtUpgrade" class="col-form-label">Repair/Upgrade:</label>
                                    <div class="input-group">
                                        @{
                                            var upPrice = String.Format("{0:0.00}", Model.UpgradePrice);
                                        }
                                        <input type="text" id="txtUpgrade" class="form-control text-right" asp-for="@upPrice" onkeypress="isNumberDecimal(this, event);" autocomplete="off">
                                        <span class="input-group-text" id="txtPurchasePrice-addon1">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-rupee" viewBox="0 0 16 16">
                                                <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4z"></path>
                                            </svg>
                                        </span>
                                    </div>
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="txtPurcRepair" class="col-form-label">Total (Purhase + Repair/Upgrade):</label>
                                    <div class="input-group">
                                        @{
                                            var repPrice = String.Format("{0:0.00}", Model.TotalPrice);
                                        }
                                        <input type="text" id="txtPurcRepair" class="form-control text-right" asp-for="@repPrice" onkeypress="isNumberDecimal(this, event);" placeholder="Total Price" autocomplete="off" tabindex="-1" readonly>
                                        <span class="input-group-text" id="txtPurchasePrice-addon1">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-currency-rupee" viewBox="0 0 16 16">
                                                <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4z"></path>
                                            </svg>
                                        </span>
                                    </div>
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="txtPayMode" class="col-form-label">Payment Mode:</label>
                                    <input type="text" id="txtPayMode" class="form-control" asp-for="PaymentModeName" autocomplete="off" readonly="@(transferPurchaseID > 0)">
                                    <span class="field-validation-error"></span>
                                </div>
                                <div class="">
                                    <label for="txtBuyLead" class="col-form-label">Buying Lead:</label>
                                    <input type="text" id="txtBuyLead" class="form-control" asp-for="BuyingLead" autocomplete="off" readonly="@(transferPurchaseID > 0)">
                                    <span class="field-validation-error"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-12 col-12">
                        <div class="">
                            <div class="mt-2 text-right">
                                <button type="button" class="btn btn-custom" id="btnPurchaseUpdate" title="Update Purchase Entry"><i class="fas fa-save"></i> Update</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="@Url.Content("~/lib/select2/css/select2.min.css")" rel="stylesheet" asp-append-version="true" />
    <link href="@Url.Content("~/css/custom-css/custom-select2.css")" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="@Url.Content("~/lib/select2/js/select2.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/scripts.js")" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {

            $('#txtUpgrade').blur(function() {
                if ($(this).val() == "") {
                    $(this).val("0");
                }
            });

            $('#txtPurchaseDate:not([readonly])').datepicker({
                format: 'dd/mm/yyyy',
                endDate: '+0d',
                autoclose: true,
                todayHighlight: true,
                todayBtn: true,
                clearBtn: true
            });

            $('#ddlCategory,#ddlBrand').select2();


            var category = $('#ddlCategory').select2('data')[0];
            if (category.text == "Adjustment") {
                $('#ddlBrand').select2('val', "0");
                $('#ddlBrand').prop("disabled", true);
                $('#txtModel').attr("readonly", "readonly");
                $('#txtModel').val("");
                $('#txtUpgrade').attr("readonly", "readonly");
                $('#txtUpgrade').val("");
                $('#txtBuyLead').attr("readonly", "readonly");
                $('#txtBuyLead').val("");
            }

        });
    </script>
}