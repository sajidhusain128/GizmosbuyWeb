@{
    Layout = "_Layout"; // optional, use your site layout
    ViewData["Title"] = "Page Not Found";
}

<div class="body">
    <h3>404 - Page Not Found</h3>
    <div class="message">
        <h1>Oops! The page you’re looking for doesn’t exist.</h1>
        <p>It may have been moved or deleted.</p>
    </div>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Go Home</a>
</div>

<style type="text/css">

    .body {
        height: 500px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        /* background: linear-gradient(to bottom right, #EEE, #AAA); */
        /*  background-color: rgb(248 183 57 / 50%); */
    }

        .body h3 {
            color: red;
            font-size: 60px;
            margin-bottom: 35px;
        }

    h1 {
        margin: 40px 0 20px;
    }
  
    .message {
        text-align: center;
    }

</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            var interval = 0;
            //$('.body h3').css("text-shadow","0px 0px 10px rgba(240,160,0,1)");
            setInterval(function () {
                if (interval == 0) {
                    $('.body h3').css("text-shadow", "0px 0px 10px rgba(240,160,0,1)");
                    interval = 1;
                }
                else {
                    $('.body h3').css("text-shadow", "");
                    interval = 0;
                }

            }, 500)

        });
    </script>
}