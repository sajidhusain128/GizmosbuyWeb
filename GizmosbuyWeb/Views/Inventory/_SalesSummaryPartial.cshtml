@model List<Gizmosbuy.Core.Interfaces.ISalesSummaryModel>
@{
    ViewBag.Title = "_SalesSummaryPartial";
}

<div class="">
    <h6 style="font-weight:bold">Sales Report</h6>
    <div class="custom-table table table-bordered table-responsive table-sm table-striped custom-box-shadow">
        <table id="lblSummery" class="">
            <thead>
                <tr>
                    <th class="text-nowrap">Category</th>
                    <th class="text-nowrap" style="text-align: right;">Quantity</th>
                    <th class="text-nowrap" style="text-align: right;">Selling Price Revenue</th>
                    <th class="text-nowrap" style="text-align: right;">Sum of Profit</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        var str = item.CategoryName.Contains("Total") ? "font-weight:bold;border-top: 2px solid #047716;" : "";

                        <tr style="@str">
                            <td class="text-nowrap">@item.CategoryName</td>
                            <td class="text-nowrap" align="right">@item.Quantity</td>
                            <td class="text-nowrap" align="right">&#8377; @Math.Round(item.SellingPrices, 2)</td>
                            <td class="text-nowrap" align="right">&#8377; @Math.Round(item.Sumofprofit, 2)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" align="center"> Record not found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>