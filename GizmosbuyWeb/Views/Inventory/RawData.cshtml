@model Gizmosbuy.Core.Interfaces.IDateRange

<div class="page-header">
    <div class="header-title">Raw Data List</div>
</div>
<div class="page-content">
    <div class="page-title">
        <h3></h3>
    </div>
    <div class="page-body">

        <div class="form-group">
            <div class="row">
                <div class="col-md-4 mb-2" style="align-content: center;">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <label for="txtStartDate" class="col-form-label">Start Date:</label>
                        </div>
                        <div class="col-md-8">
                            <div class="input-group">
                                <input type="text" id="txtStartDate" asp-for="StartDate" class="form-control" placeholder="DD/MM/YYYY" maxlength="10" pattern="\d{1,2}/\d{1,2}/\d{4}" onkeyup="dateAutoFormatter(event)" autocomplete="off">
                                <span class="input-group-text" id="basic-addon1">
                                    <i class="fas fa-calendar-alt"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-2" style="align-content: center;">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <label for="txtEndDate" class="col-form-label">End Date:</label>
                        </div>
                        <div class="col-md-8">
                            <div class="input-group">
                                <input type="text" id="txtEndDate" asp-for="EndDate" class="form-control" placeholder="DD/MM/YYYY" maxlength="10" pattern="\d{1,2}/\d{1,2}/\d{4}" onkeyup="dateAutoFormatter(event)" autocomplete="off">
                                <span class="input-group-text" id="basic-addon1">
                                    <i class="fas fa-calendar-alt"></i>
                                </span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <span class="field-validation-error"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-2 text-right" style="display: flex;justify-content: space-between;align-items: center;">
                    <button type="button" class="btn btn-custom " id="btnSearchRawData" title="Search"><i class="fas fa-search"></i> Search</button>
                    <button type="button" class="btn btn-custom " id="btnExportRawData" title="Export To Excel" data-bs-toggle="tooltip"><i class="fas fa-file-excel"></i> Export</button>
                </div>
            </div>

        </div>

        <div class="custom-table table table-bordered table-responsive table-sm mt-2 ">
            <table id="tblRawData" class="">
                <thead>
                    <tr>
                        <th></th>
                    </tr>
                </thead>
               @*  <thead class="filter-head">
                    <tr >
                        <th></th>
                    </tr>
                </thead> *@
                <tbody>
                    <tr>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="@Url.Content("~/lib/moment.js/moment.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/scripts.js")" asp-append-version="true"></script>
    
    <script type="text/javascript">

        $(document).ready( function () {
           
            var curDateMonth = new Date();
            $('#txtEndDate').val(localDateFormat(curDateMonth, 'dd/mm/yyyy'));

            var prvDateMonth = new Date(curDateMonth.getFullYear(), curDateMonth.getMonth() - 1, curDateMonth.getDate());
        
            $('#txtStartDate').val(localDateFormat(prvDateMonth, 'dd/mm/yyyy'));

            $('#txtStartDate').datepicker({
                format: 'dd/mm/yyyy',
                endDate: '+1d',
                maxDate: 'today',
                autoclose: true,
                todayHighlight: true,
                todayBtn: true,
                clearBtn: true
            }).on('changeDate', function(e) {
                // Dynamically set the start date based on the selected date
                $('#txtEndDate').datepicker('setStartDate', e.date);
            });


            $('#txtEndDate').datepicker({
                format: 'dd/mm/yyyy',
                endDate: '+1d',
                maxDate: 'today',
                autoclose: true,
                todayHighlight: true,
                todayBtn: true,
                clearBtn: true
            }).on('changeDate', function(e) {
                // Dynamically set the start date based on the selected date
                $('#txtStartDate').datepicker('setEndDate', e.date);
            });

            callRawData()  
        }); 
    </script>
}