@model List<Gizmosbuy.Core.Interfaces.IPurchaseSummaryModel>
@{
    ViewBag.Title = "_PurchaseSummaryPartial";
}

<div class="">
    <h6 style="font-weight:bold">Inventory Report</h6>
    <div class="custom-table table table-bordered table-responsive table-sm table-striped custom-box-shadow">
        <table id="lblSummery" class="">
            <thead>
                <tr>
                    <th class="text-nowrap">Category</th>
                    <th class="text-nowrap">Quantity</th>
                    <th class="text-nowrap">Purchase Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        var str = item.CategoryName.Contains("Total") ? "font-weight:bold" : "";

                        <tr style="@str">
                            <td class="text-nowrap">@item.CategoryName</td>
                            <td class="text-nowrap" align="right">@item.Quantity</td>
                            <td class="text-nowrap" align="right">@Math.Round(item.PurchaseAmount, 2)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" align="center"> Record not found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>