@using Gizmosbuy.Core.Interfaces
@model Gizmosbuy.Core.Models.SummaryModel
@{
    TempData["Title"] = "Summary";
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>Summary</h1>
        </div>
    </div>
</div>
<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">Summary Data</div>
        </div>
        <div class="page-content">
            <div class="page-title">
                <h3></h3>
            </div>
            <div class="page-body p-0">
                @using (Html.BeginForm("Summary", "Inventory", FormMethod.Post, new { id = "frmSummery" }))
                {
                    <div class="col-md-12 col-12">
                        <div class="row">
                            <div class="col-md-6 col-12">
                                <h6 class="" style="font-weight:bold">Search Report :</h6>
                                <div class="row">
                                    <div class="form-group p-0">
                                        <div class="col-md-12 col-12 mb-2" id="divSalesType">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="ddlSalesType" class="col-form-label">Sales Type:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    @{
                                                        var listSalesType = new List<SelectListItem>
                                                                                        {
                                                                                        new SelectListItem{ Text="Both", Value = "Both" ,Selected = true},
                                                                                        new SelectListItem{ Text="Only Sales", Value = "OnlySales" },
                                                                                        new SelectListItem{ Text="Store Transfer", Value = "StoreTransfer" },
                                                                                        };
                                                    }

                                                    @Html.DropDownList("SalesType", listSalesType, null, new { id = "ddlSalesType", @class = "form-select select2-dropdown", @style = "width:100% !important" })
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="ddlLoaction" class="col-form-label">Store:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    @{
                                                        //var isDisabled = ViewBag.defaultValue != null ? "disabled" : "";
                                                    }
                                                    @Html.DropDownList("LocationId", new SelectList(((List<ILocationModel>)ViewBag.LocationModel).Select(x => new { Value = x.LocationId, Text = x.LocationName }), "Value", "Text"), null, new { id = "ddlLoaction", @class = "form-select select2-dropdown", @style = "width:100% !important" })
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="ddlStatus" class="col-form-label">Stock Status:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    @{
                                                        var list = new List<SelectListItem>
                                                                                        {
                                                                                        new SelectListItem{ Text="Sold", Value = "Sales" ,Selected = true},
                                                                                        new SelectListItem{ Text="Pending", Value = "Purchase" },
                                                                                        };
                                                    }

                                                    @Html.DropDownListFor(Model => Model.Status, list, null, new { id = "ddlStatus", @class = "form-select select2-dropdown", @style = "width:100% !important" })
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2" id="divSellYear">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="txtSellYear" class="col-form-label">Sell Year:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    <input type="text" id="txtSellYear" class="form-control" placeholder="Year" maxlength="4" autocomplete="off" onkeypress="isNumberDecimal(this, event);">
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2" id="divSellMonth">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="ddlSellMonth" class="col-form-label">Sell Month:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    @Html.DropDownList("Months", (List<SelectListItem>)ViewBag.Months, null, new { id = "ddlSellMonth", @class = "form-select select2-dropdown", @style = "width:100% !important" })
                                                    @* <input type="text" id="txtSellMonth" class="form-control" placeholder="Month" maxlength="3" autocomplete="off" onkeydown="return false"> *@
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2" id="divSellDate">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="ddlSellDate" class="col-form-label">Sell Date:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    @Html.DropDownListFor(Model => Model.SellDate, (List<SelectListItem>)ViewBag.Date, "Select Date", new { id = "ddlSellDate", @class = "form-select select2-dropdown", @style = "width:100% !important" })
                                                    @* <input type="text" id="txtSellMonth" class="form-control" placeholder="Month" maxlength="3" autocomplete="off" onkeydown="return false"> *@
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    <div class="text-right">
                                                        <button type="button" class="btn btn-custom " id="btnSearchSummary" title="Search Summery Report"><i class="fas fa-search"></i> Search</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="row ">
                                    <div id="divSummaryData">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">Expense Summary</div>
        </div>
        <div class="page-content">
            <div class="page-title">
                <h3></h3>
            </div>
            <div class="page-body p-0">
                @using (Html.BeginForm("Summary", "Inventory", FormMethod.Post, new { id = "frmExpenseSummery" }))
                {
                    <div class="col-md-12 col-12">
                        <div class="row">
                            <div class="col-md-6 col-12">
                                <h6 class="" style="font-weight:bold">Search Report :</h6>
                                <div class="row">
                                    <div class="form-group p-0">
                                        <div class="col-md-12 mb-2">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="ddlExpenseLoaction" class="col-form-label">Store:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    @{
                                                        //var isDisabled = ViewBag.defaultValue != null ? "disabled" : "";
                                                    }
                                                    @Html.DropDownList("ExpenseLocationId", new SelectList(((List<ILocationModel>)ViewBag.LocationModel).Select(x => new { Value = x.LocationId, Text = x.LocationName }), "Value", "Text"), null, new { id = "ddlExpenseLoaction", @class = "form-select select2-dropdown", @style = "width:100% !important" })
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2" id="divExpenseYear">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="txtExpenseYear" class="col-form-label">Sell Year:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    <input type="text" id="txtExpenseYear" class="form-control" placeholder="Year" maxlength="4" autocomplete="off" onkeypress="isNumberDecimal(this, event);">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                                <div class="col-auto">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 mb-2" id="divExpenseMonth">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                    <label for="ddlExpenseMonth" class="col-form-label">Sell Month:</label>
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    @Html.DropDownList("ExpenseMonths", (List<SelectListItem>)ViewBag.Months, null, new { id = "ddlExpenseMonth", @class = "form-select select2-dropdown", @style = "width:100% !important" })
                                                    @* <input type="text" id="txtSellMonth" class="form-control" placeholder="Month" maxlength="3" autocomplete="off" onkeydown="return false"> *@
                                                </div>
                                                <div class="col-auto">
                                                    <span class="field-validation-error"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 mb-2">
                                            <div class="row align-items-center">
                                                <div class="col-md-4 col-12">
                                                </div>
                                                <div class="col-md-6 col-12">
                                                    <div class="text-right">
                                                        <button type="button" class="btn btn-custom " id="btnSearchExpenseSummary" title="Search Expense Summery Report"><i class="fas fa-search"></i> Search</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-12">
                                <div class="row">
                                    <div id="divExpenseSummaryData">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="@Url.Content("~/lib/select2/css/select2.min.css")" rel="stylesheet" asp-append-version="true" />
    <link href="@Url.Content("~/css/custom-css/custom-select2.css")" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="@Url.Content("~/lib/select2/js/select2.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/scripts.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/finance.js")" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            $('#txtSellYear,#txtExpenseYear').datepicker({
                format: "yyyy",
                viewMode: "years",
                minViewMode: "years",
                autoclose: true,
                todayHighlight: true,
                clearBtn: true
            }).datepicker("setDate", geMonthFromDate(new Date().getFullYear()));

            $('#ddlLoaction,#ddlStatus,#ddlSellMonth,#ddlSellDate,#ddlSalesType,#ddlExpenseLoaction,#ddlExpenseMonth').select2();

            var ddlVal = '@ViewBag.defaultLocationId';

            if (ddlVal != null && ddlVal != "") {
                $('#ddlLoaction').select2('val', ddlVal);
                $("#ddlLoaction").prop("disabled", true);
                $('#ddlExpenseLoaction').select2('val', ddlVal);
                $("#ddlExpenseLoaction").prop("disabled", true);
            }
            else {
                $("#ddlLoaction").prop("disabled", false);
                $("#ddlExpenseLoaction").prop("disabled", false);
            }
        });
    </script>
}