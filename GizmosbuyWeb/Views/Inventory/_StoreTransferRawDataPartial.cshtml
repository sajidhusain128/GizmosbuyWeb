@using Gizmosbuy.Core.Interfaces
@using Gizmosbuy.Core.Models
@model List<Gizmosbuy.Core.Interfaces.ISalesSummaryModel>
@{
    ViewBag.Title = "_SalesSummaryPartial";
}

<div class="col-12">
    <h6 style="font-weight:bold">Sales Report</h6>
    <div class="custom-table table table-bordered table-responsive table-sm table-striped">
        <table id="lblSummery" class="">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Quantity</th>
                    <th>Selling Price Revenue</th>
                    <th>Sum of Profit</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        var str = item.CategoryName.Contains("Total") ? "font-weight:bold" : "";

                        <tr style="@str">
                            <td>@item.CategoryName</td>
                            <td align="right">@item.Quantity</td>
                            <td align="right">@Math.Round(item.SellingPrices, 2)</td>
                            <td align="right">@Math.Round(item.Sumofprofit, 2)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" align="center"> Record not found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>