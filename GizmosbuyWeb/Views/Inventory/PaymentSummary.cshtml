@using Gizmosbuy.Core.Constants
@using Gizmosbuy.Core.Interfaces
@using Gizmosbuy.BAL.Commons;
@model Gizmosbuy.Core.Models.SummaryModel
@{
    TempData["Title"] = "Payment Summary";
    string userRole = Utilities.GetSessionValue(Constant.Role, Context.Request.HttpContext);
    string userLocation = Utilities.GetSessionValue(Constant.Location, Context.Request.HttpContext);
    int userLocationId = Int32.TryParse(Utilities.GetSessionValue(Constant.LocationId, Context.Request.HttpContext), out int result) ? result : -1;
}

<div class="col-md-12">
    <div class="row">
        <div class="body-title">
            <h1>
                Summary
                @{
                    if (userRole == "Admin" && userLocation != "")
                    {
                        <span>(@userLocation)</span>
                    }
                }
            </h1>
        </div>
    </div>
</div>
@if (userRole == "SuperAdmin")
{
    <div class="container-block">
        <div class="section-block">
            @* <div class="page-header">
            <div class="header-title">Summary Data</div>
        </div> *@
            <div class="page-content p-0">
                @*                 <div class="page-title">
                    <h3></h3>
                </div> *@
                <div class="page-body">
                    @using (Html.BeginForm("Summary", "Inventory", FormMethod.Post, new { id = "frmSummery" }))
                    {
                        <div class="col-md-12 col-12">
                            <div class="row">
                                <div class="col-md-4 p-2">
                                    <div class="">
                                        @Html.DropDownListFor(Model => Model.LocationId, new SelectList(((List<ILocationModel>)ViewBag.LocationModel).Select(x => new { Value = x.LocationId, Text = x.LocationName }), "Value", "Text"), null, new { id = "ddlLoactionfilter", @class = "form-select select2-dropdown", @style = "width: 100% !important" })
                                    </div>
                                </div>
                                <div class="col-auto p-2 align-content-center">
                                    <div class="">
                                        <button type="button" class="btn btn-custom " id="btnSearchStoreTransferSummary" title="Search Summery Report"><i class="fas fa-search"></i> Search</button>
                                    </div>
                                </div>
                                <div class="col-auto p-2 align-content-center align-items-center">
                                    <div class="">
                                        <span id="errorLocation" class="field-validation-error"></span>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<div class="container-block">
    <div class="section-block">
        <div class="page-header">
            <div class="header-title">
                <div class="row">
                    <div class="col-md-6 col-6 align-content-center">
                        Store Transfer Raw Data
                    </div>
                    <div class="col-md-6 col-6 align-content-center text-right">
                        <button id="btnExportStoreTransferRawData" class="btn btn-custom btn-sm" title="Export To Excel"><i class="fas fa-file-excel"></i> Export</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="">
            <div class="col-md-12 col-sm-12">
                <div class="row">
                    <div id="divStoreTransferRawData" class="custom-table table table-bordered table-responsive table-sm m-0">
                        <table id="tblStoreTransferRawData" class="">
                            <thead>
                                <tr>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div id="storeTransferRawDataNoDataMessage" class="text-center" style="display:none;">
                        No records available to display
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12">
    <div class="row">
        <div class="container-block col-md-6 col-12">
            <div class="section-block">
                <div class="page-header">
                    <div class="header-title">
                        <div class="row">
                            <div class="col-md-6 col-6 align-content-center">
                                Payment Summary
                            </div>
                            <div class="col-md-6 col-6 align-content-center text-right">
                                <button id="btnExportStoreTransferPaymentSummary" class="btn btn-custom btn-sm" title="Export To Excel"><i class="fas fa-file-excel"></i> Export</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="page-content p-0">
                    <div class="page-body p-0">
                        <div class="col-md-12 col-12">
                            <div class="row">
                                <div id="divPaymentSummary" class="custom-table table table-bordered table-responsive table-sm m-0">
                                    <table id="tblStoreTransferPaymentSummary" class="">
                                        <thead>
                                            <tr>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div id="paymentSummaryNoDataMessage" class="text-center" style="display:none;">
                                    No records available to display
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container-block col-md-6 col-12">
            <div class="section-block">
                <div class="page-header">
                    <div class="header-title">Payment Summary Amount</div>
                </div>
                <div class="page-content">
                    <div class="page-body">
                        <div class="col-md-12 col-12">
                            <div class="row">
                                <div class="stats">
                                    <div class="row g-3">
                                        <div class="col-md col-12">
                                            <div class="stat place-items-center stat-warning">
                                                <div class="stat-title"><i class="fa fa-solid fa-receipt "></i> Total Bill</div>
                                                <div class="stat-value"><span id="lblTotalBill">&#8377; 0</span></div>
                                            </div>
                                        </div>
                                        <div class="col-md col-12">
                                            <div class="stat place-items-center stat-success">
                                                <div class="stat-title"><i class="fa fa-solid fa-sack-dollar"></i> Total Paid</div>
                                                <div class="stat-value"><span id="lblTotalPaid">&#8377; 0</span></div>
                                            </div>
                                        </div>
                                        <div class="col-md col-12">
                                            <div class="stat place-items-center stat-error">
                                                <div class="stat-title"><i class="fa fa-solid fa-wallet"></i> Balance </div>
                                                <div class="stat-value"><strong id="lblTotalBalance">&#8377; 0</strong></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="@Url.Content("~/lib/select2/css/select2.min.css")" rel="stylesheet" asp-append-version="true" />
    <link href="@Url.Content("~/css/custom-css/custom-select2.css")" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="@Url.Content("~/lib/moment.js/moment.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/lib/select2/js/select2.min.js")" asp-append-version="true"></script>
    <script src="@Url.Content("~/js/store.js")" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {

            $('#ddlLoactionfilter').select2();

            var searchLocationId = ("@userRole" == "Admin") ? parseInt(@userLocationId) : parseInt($('#ddlLoactionfilter').select2('val'));
            runSequentialTasks();

            async function runSequentialTasks() {
                const results = await Promise.allSettled([
                    callStoreTransferRawData(searchLocationId),
                    callStoreTransferPaymentData(searchLocationId),
                    getStoreTransferCalculation(searchLocationId)
                ]);
            }

            runSequentialTasks();
        });
    </script>
}