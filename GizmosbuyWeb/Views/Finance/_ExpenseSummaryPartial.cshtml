@model List<Gizmosbuy.Core.Interfaces.IExpenseSummaryModel>
@{
    ViewBag.Title = "_ExpenseSummaryPartial";
}

<div class="">
<h6 style="font-weight:bold">Expense Report</h6>
    <div class="custom-table table table-bordered table-responsive table-sm table-striped custom-box-shadow">
    <table id="lblSummery" class="">
        <thead>
            <tr>
                <th>Expense Type</th>
                <th style="text-align: right;">Sum of Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                foreach (var item in Model)
                {
                        var str = item.ExpenseType.Contains("Total") ? "font-weight:bold;border-top: 2px solid #047716;" : "";

                    <tr style="@str">
                            <td>@item.ExpenseType</td>
                        <td align="right">&#8377; @Math.Round(item.SumAmount, 2)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" align="center"> Record not found</td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>