using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {

    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      
    }
  }
}
</ScriptText>
  <Dictionary>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlqzP/32u1QtzIsUJqKG+CmmrmNuDHT7oBRMr0z3pkCSb7GvmwRZ2uAT+4NEn+xtN0Dvgq1QEeJg/MmhO5XHpCk7VAvjAO/TSCa31xNocc+N0eJ+ri/kBBgxmShG/8YBZ/2KlHjYQLp+ubHsKSrEqOXLhxctcOtUY63LIcfobUGep1o6AlD+j3Nvhy81Pp8IQXNdUdHygKFGudnWEZtW+MHw5z8BCeUY3IqkVT7yB7ESmM=">
      <TableDataSource Name="Table" Alias="SalesData" DataType="System.Int32" Enabled="true" SelectCommand="SELECT &#13;&#10;ROW_NUMBER() OVER(ORDER BY S.SalesID) AS RowNum,&#13;&#10;S.SalesID,&#13;&#10;CM.CategoryName,&#13;&#10;BM.BrandName,&#13;&#10;p.Model,&#13;&#10;p.SerialNo,&#13;&#10;P.Specifications,&#13;&#10;S.SellingQuantity,&#13;&#10;S.SellingPrice&#13;&#10;FROM Sales S WITH(NOLOCK)&#13;&#10;JOIN Purchases P WITH(NOLOCK) ON P.PurchaseID = S.PurchaseID&#13;&#10;JOIN CategoryMaster CM WITH(NOLOCK) ON CM.CategoryID = P.CategoryID&#13;&#10;JOIN BrandMaster BM WITH(NOLOCK) ON BM.BrandID = P.BrandID&#13;&#10;">
        <Column Name="BrandName" DataType="System.String"/>
        <Column Name="CategoryName" DataType="System.String"/>
        <Column Name="Model" DataType="System.String"/>
        <Column Name="RowNum" DataType="System.Int64"/>
        <Column Name="SalesID" DataType="System.Int32"/>
        <Column Name="SellingPrice" DataType="System.Decimal" Format="Currency"/>
        <Column Name="SellingQuantity" DataType="System.Int32"/>
        <Column Name="SerialNo" DataType="System.String"/>
        <Column Name="Specifications" DataType="System.String"/>
        <CommandParameter Name="InvoiceNo" DataType="22" Size="100"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <MsSqlDataConnection Name="Connection" ConnectionString="rijcmlqzP/32u1QtzIsUJqKG+CmmrmNuDHT7oBRMr0z3pkCSb7GvmwRZ2uAT+4NEn+xtN0Dvgq1QEeJg/MmhO5XHpCk7VAvjAO/TSCa31xNocc+N0eJ+ri/kBBgxmShG/8YBZ/2KlHjYQLp+ubHsKSrEqOXLhxctcOtUY63LIcfobUGep1o6AlD+j3Nvhy81Pp8IQXNdUdHygKFGudnWEZtW+MHwwkcHODSTZpzHvz7Th8T2CI=">
      <TableDataSource Name="Table3" Alias="SalesHeader" DataType="System.Int32" Enabled="true" SelectCommand="SELECT TOP 1&#13;&#10;S.CustomerName,&#13;&#10;s.ContactNo,&#13;&#10;s.[Location],&#13;&#10;S.BillNo as InvoiceNo,&#13;&#10;s.SellingDate,&#13;&#10;PMM.PaymentModeName,&#13;&#10;s.SellingLead,&#13;&#10;'' as TotalPriceInWord&#13;&#10;FROM Sales S WITH(NOLOCK)&#13;&#10;LEFT JOIN PaymentModeMaster PMM WITH(NOLOCK) ON PMM.PaymentModeID = S.PaymentModeID">
        <Column Name="CustomerName" DataType="System.String"/>
        <Column Name="ContactNo" DataType="System.Int64"/>
        <Column Name="Location" DataType="System.String"/>
        <Column Name="SellingDate" DataType="System.DateTime"/>
        <Column Name="PaymentModeName" DataType="System.String"/>
        <Column Name="SellingLead" DataType="System.String"/>
        <Column Name="InvoiceNo" DataType="System.String"/>
        <Column Name="TotalPriceInWord" DataType="System.String"/>
      </TableDataSource>
    </MsSqlDataConnection>
    <Total Name="GrandTotal" Expression="[SalesData.SellingPrice]" Evaluator="Data1" ResetAfterPrint="false"/>
    <Total Name="PageTotal" Expression="[SalesData.SellingPrice]" Evaluator="Data1"/>
    <Total Name="PageTotalQty" Expression="[SalesData.SellingQuantity]" Evaluator="Data1"/>
  </Dictionary>
